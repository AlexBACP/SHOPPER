# ─────────────────────────────────────────────────────────────
#  SHOPPER · .env de PRODUCCIÓN (raíz del proyecto, lo lee compose)
#  En el servidor:  cp deploy/.env.prod.example .env  y rellena.
#  NUNCA subir este .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (pon una contraseña fuerte, NO "1234")
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTO_password_fuerte
DB_NAME=shopperdb
DB_PORT=5432

# URLs públicas — se embeben en el bundle del frontend al hacer build.
# La API va por ruta /api en el mismo dominio (Nginx la enruta al backend).
NEXT_PUBLIC_API_URL=https://shopper.proyectoscampus.top/api
NEXT_PUBLIC_SITE_URL=https://shopper.proyectoscampus.top

# Puertos LOCALES en el host (solo 127.0.0.1, detrás de Nginx).
# Cámbialos si chocan con otro proyecto del servidor.
FRONTEND_HOST_PORT=3030
BACKEND_HOST_PORT=3031
