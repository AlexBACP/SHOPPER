# ─────────────────────────────────────────────────────────────
#  SHOPPER · .env de PRODUCCIÓN (raíz del proyecto, lo lee compose)
#  En el servidor:  cp deploy/.env.prod.example .env  y rellena.
#  NUNCA subir este .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (pon una contraseña fuerte, NO "1234")
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTO_password_fuerte
DB_NAME=shopperdb
DB_PORT=5432

# URLs públicas — se embeben en el bundle del frontend al hacer build.
# Deben ser HTTPS con tu dominio real.
NEXT_PUBLIC_API_URL=https://api.proyectoscampus.top
NEXT_PUBLIC_SITE_URL=https://proyectoscampus.top
