# ─────────────────────────────────────────────────────────────
#  Variables que lee docker-compose en la raíz del proyecto.
#  Copia este archivo como `.env` (mismo nivel que docker-compose.yml).
#  Los secretos de la app (Cloudinary, Resend, Wompi, JWT…) viven en
#  backend/.env — compose los lee con `env_file`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (usuario/contraseña iniciales del contenedor)
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=shopperdb
DB_PORT=5432

# Frontend en producción (se embeben en el bundle del cliente al hacer build)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
