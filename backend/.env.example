# ================================================================
#  SHOPPER — Variables de entorno del backend
#  Copia este archivo como .env y completa los valores reales.
#  NUNCA subas el archivo .env a un repositorio.
# ================================================================

# ── Base de datos ─────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/shopper_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_postgres
DB_NAME=shopperdb

# ── Entorno ───────────────────────────────────────────────────
NODE_ENV=development

# ── Redis (opcional, para caché/rate-limit) ───────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── JWT — usa strings largos y aleatorios ─────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_diferente

# ── Cloudinary (subida de imágenes) ──────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Email por SMTP (Nodemailer) ──────────────────────────────
# Ejemplo Gmail: crea una "Contraseña de aplicación" en
# myaccount.google.com → Seguridad → Contraseñas de aplicaciones
# (requiere verificación en 2 pasos activada en la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx          # la contraseña de aplicación (16 caracteres)
# El remitente: con Gmail debe ser tu mismo correo (lo reescribe si no coincide)
EMAIL_FROM=Shopper <tucorreo@gmail.com>

# ── Google Gemini (chatbot IA) ────────────────────────────────
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Wompi — Pagos Colombia ────────────────────────────────────
# Obtener en: https://commerce.wompi.co
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_ENV=sandbox

# ── OAuth Social Login ────────────────────────────────────────
# Google: https://console.cloud.google.com → APIs → Credenciales
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx

# Facebook: https://developers.facebook.com → Tus apps
FACEBOOK_APP_ID=tu_app_id_numerico
FACEBOOK_APP_SECRET=tu_app_secret_hexadecimal

# ── URLs ──────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
